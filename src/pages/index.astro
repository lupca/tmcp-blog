---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PostCard from "../components/PostCard.astro";
import { HERO, SITE, TOPICS } from "../consts";
import { pb } from "../lib/pocketbase";

// Fetch latest 3 published posts for featured section
let featuredPosts: any[] = [];
try {
	featuredPosts = await pb.collection("posts").getFullList({
		filter: 'status = "published"',
		sort: "-created",
		perPage: 3,
	});
} catch {
	// PocketBase may not be available — graceful fallback
}
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead title={SITE.title} description={SITE.description} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Hero Section -->
			<section class="hero" aria-label="Introduction">
				<div class="hero-bg">
					<div class="hero-gradient"></div>
					<div class="hero-grid"></div>
				</div>
				<div class="container hero-content">
					<h1 class="hero-headline animate-in">{HERO.headline}</h1>
					<p class="hero-subheadline animate-in animate-delay-1">
						{HERO.subheadline}
					</p>
					<a
						href={HERO.cta.href}
						class="btn-primary animate-in animate-delay-2"
					>
						{HERO.cta.label}
						<svg
							width="16"
							height="16"
							viewBox="0 0 16 16"
							fill="none"
						>
							<path
								d="M3 8h10M9 4l4 4-4 4"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</a>
				</div>
			</section>

			<!-- Featured Posts -->
			{
				featuredPosts.length > 0 && (
					<section class="section" aria-label="Featured articles">
						<div class="container">
							<h2 class="section-title">Featured Articles</h2>
							<div class="post-grid">
								{featuredPosts.map((post, i) => (
									<PostCard
										title={post.title}
										description={post.description}
										date={post.created}
										slug={post.slug}
										heroImage={post.heroImage}
										tags={post.tags || []}
										featured={i === 0}
									/>
								))}
							</div>
						</div>
					</section>
				)
			}

			<!-- Topics Section -->
			<section class="section" aria-label="Topics we cover">
				<div class="container">
					<h2 class="section-title">What We Write About</h2>
					<div class="topics-grid">
						{
							TOPICS.map((topic, i) => (
								<div
									class={`topic-card glass-card animate-in animate-delay-${
										i + 1
									}`}
								>
									<span class="topic-icon">{topic.icon}</span>
									<h3>{topic.title}</h3>
									<p>{topic.description}</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- CTA Section -->
			<section class="cta-section" aria-label="Call to action">
				<div class="container cta-content">
					<h2>Stay Up to Date</h2>
					<p>
						Follow our engineering journey — new articles every week
						on AI agents, DevOps, and modern infrastructure.
					</p>
					<a href="/blog" class="btn-primary">
						Explore All Posts
						<svg
							width="16"
							height="16"
							viewBox="0 0 16 16"
							fill="none"
						>
							<path
								d="M3 8h10M9 4l4 4-4 4"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"></path>
						</svg>
					</a>
				</div>
			</section>
		</main>
		<Footer />
		<style>
			/* --- Hero --- */
			.hero {
				position: relative;
				min-height: 80vh;
				display: flex;
				align-items: center;
				justify-content: center;
				overflow: hidden;
			}

			.hero-bg {
				position: absolute;
				inset: 0;
				z-index: 0;
			}

			.hero-gradient {
				position: absolute;
				inset: 0;
				background: var(--gradient-hero);
				opacity: 0.8;
			}

			.hero-gradient::before {
				content: "";
				position: absolute;
				top: 20%;
				left: 10%;
				width: 400px;
				height: 400px;
				background: radial-gradient(
					circle,
					rgba(34, 211, 238, 0.15) 0%,
					transparent 70%
				);
				border-radius: 50%;
				animation: pulse-glow 6s ease-in-out infinite;
			}

			.hero-gradient::after {
				content: "";
				position: absolute;
				bottom: 10%;
				right: 15%;
				width: 350px;
				height: 350px;
				background: radial-gradient(
					circle,
					rgba(167, 139, 250, 0.15) 0%,
					transparent 70%
				);
				border-radius: 50%;
				animation: pulse-glow 6s ease-in-out infinite 3s;
			}

			.hero-grid {
				position: absolute;
				inset: 0;
				background-image: linear-gradient(
						rgba(255, 255, 255, 0.03) 1px,
						transparent 1px
					),
					linear-gradient(
						90deg,
						rgba(255, 255, 255, 0.03) 1px,
						transparent 1px
					);
				background-size: 60px 60px;
				mask-image: radial-gradient(
					ellipse 80% 80% at 50% 50%,
					black 30%,
					transparent 80%
				);
				-webkit-mask-image: radial-gradient(
					ellipse 80% 80% at 50% 50%,
					black 30%,
					transparent 80%
				);
			}

			.hero-content {
				position: relative;
				z-index: 1;
				text-align: center;
				max-width: 800px;
				padding: var(--space-4xl) var(--space-xl);
			}

			.hero-headline {
				font-size: clamp(2.5rem, 6vw, 4rem);
				font-weight: 800;
				letter-spacing: -0.03em;
				line-height: 1.1;
				margin-bottom: var(--space-lg);
				background: linear-gradient(
					135deg,
					var(--text-primary) 0%,
					var(--accent-cyan) 50%,
					var(--accent-violet) 100%
				);
				background-size: 200% 200%;
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
				animation: gradientShift 8s ease infinite;
			}

			.hero-subheadline {
				font-size: clamp(1rem, 2vw, 1.2rem);
				color: var(--text-secondary);
				max-width: 600px;
				margin: 0 auto var(--space-xl);
				line-height: 1.6;
			}

			/* --- Section --- */
			.section-title {
				margin-bottom: var(--space-2xl);
				font-size: clamp(1.5rem, 3vw, 2rem);
			}

			/* --- Post Grid --- */
			.post-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
				gap: var(--space-xl);
			}

			/* --- Topics --- */
			.topics-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
				gap: var(--space-lg);
			}

			.topic-card {
				padding: var(--space-xl);
				display: flex;
				flex-direction: column;
				gap: var(--space-sm);
			}

			.topic-icon {
				font-size: 2rem;
				margin-bottom: var(--space-sm);
			}

			.topic-card h3 {
				font-size: 1.1rem;
				color: var(--text-primary);
			}

			.topic-card p {
				color: var(--text-tertiary);
				font-size: 0.9rem;
				line-height: 1.5;
			}

			/* --- CTA Section --- */
			.cta-section {
				padding: var(--space-4xl) 0;
			}

			.cta-content {
				text-align: center;
				max-width: 600px;
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: var(--space-md);
			}

			.cta-content h2 {
				font-size: clamp(1.5rem, 3vw, 2rem);
			}

			.cta-content p {
				color: var(--text-secondary);
				font-size: 1rem;
			}

			@media (max-width: 768px) {
				.hero {
					min-height: 60vh;
				}

				.post-grid {
					grid-template-columns: 1fr;
				}

				.topics-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
