---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import PostCard from "../../components/PostCard.astro";
import { SITE } from "../../consts";
import { pb } from "../../lib/pocketbase";

let posts: any[] = [];
try {
	posts = await pb.collection("posts").getFullList({
		filter: 'status = "published"',
		sort: "-created",
	});
} catch {
	// PocketBase may not be available — show empty state
}
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead
			title={`Blog | ${SITE.title}`}
			description={`All articles from ${SITE.title} on AI Agents, DevOps, and modern infrastructure.`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="section">
				<div class="container">
					<div class="page-header">
						<h1>Blog</h1>
						<p>
							Deep technical articles on AI agents, DevOps, and
							the infrastructure that powers intelligent systems.
						</p>
					</div>

					{
						posts.length === 0 ? (
							<div class="empty-state">
								<p>
									No articles published yet. Check back soon!
								</p>
							</div>
						) : (
							<div class="post-grid">
								{posts.map((post, i) => (
									<PostCard
										title={post.title}
										description={post.description}
										date={post.created}
										slug={post.slug}
										heroImage={post.heroImage}
										tags={post.tags || []}
										featured={i === 0}
									/>
								))}
							</div>
						)
					}
				</div>
			</section>
		</main>
		<Footer />
		<style>
			.page-header {
				margin-bottom: var(--space-2xl);
			}

			.page-header h1 {
				margin-bottom: var(--space-sm);
			}

			.page-header p {
				color: var(--text-secondary);
				font-size: 1.1rem;
				max-width: 600px;
			}

			.post-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
				gap: var(--space-xl);
			}

			.empty-state {
				text-align: center;
				padding: var(--space-4xl) 0;
			}

			.empty-state p {
				color: var(--text-tertiary);
				font-size: 1.1rem;
			}

			@media (max-width: 768px) {
				.post-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
