---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { ABOUT, SITE, TOPICS } from "../consts";
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE.title}`} description={ABOUT.intro} />
	</head>
	<body>
		<Header />
		<main>
			<section class="section">
				<div class="container about-container">
					<div class="about-header animate-in">
						<h1>{ABOUT.title}</h1>
						<p class="about-intro">{ABOUT.intro}</p>
					</div>

					<div class="about-sections">
						{
							ABOUT.sections.map((section, i) => (
								<div
									class={`about-block animate-in animate-delay-${
										i + 1
									}`}
								>
									<h2>{section.title}</h2>
									<p>{section.content}</p>
								</div>
							))
						}
					</div>

					<div class="topics-highlight animate-in animate-delay-4">
						<h2>Our Focus Areas</h2>
						<div class="topics-grid">
							{
								TOPICS.map((topic) => (
									<div class="topic-card glass-card">
										<span class="topic-icon">
											{topic.icon}
										</span>
										<h3>{topic.title}</h3>
										<p>{topic.description}</p>
									</div>
								))
							}
						</div>
					</div>
				</div>
			</section>
		</main>
		<Footer />
		<style>
			.about-container {
				max-width: 800px;
			}

			.about-header {
				margin-bottom: var(--space-3xl);
			}

			.about-header h1 {
				margin-bottom: var(--space-lg);
				font-size: clamp(2rem, 4vw, 2.75rem);
			}

			.about-intro {
				font-size: 1.15rem;
				color: var(--text-secondary);
				line-height: 1.7;
			}

			.about-sections {
				display: flex;
				flex-direction: column;
				gap: var(--space-2xl);
				margin-bottom: var(--space-3xl);
			}

			.about-block h2 {
				font-size: 1.5rem;
				margin-bottom: var(--space-md);
				color: var(--text-primary);
			}

			.about-block p {
				color: var(--text-secondary);
				font-size: 1.05rem;
				line-height: 1.7;
			}

			.topics-highlight h2 {
				font-size: 1.5rem;
				margin-bottom: var(--space-xl);
			}

			.topics-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
				gap: var(--space-lg);
			}

			.topic-card {
				padding: var(--space-xl);
				display: flex;
				flex-direction: column;
				gap: var(--space-sm);
			}

			.topic-icon {
				font-size: 2rem;
				margin-bottom: var(--space-sm);
			}

			.topic-card h3 {
				font-size: 1.1rem;
				color: var(--text-primary);
			}

			.topic-card p {
				color: var(--text-tertiary);
				font-size: 0.9rem;
				line-height: 1.5;
			}

			@media (max-width: 768px) {
				.topics-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
