---
import { FOOTER, NAV_LINKS, SITE, SOCIAL_LINKS, TOPICS } from "../consts";
---

<footer>
	<div class="container">
		<div class="footer-grid">
			<!-- Brand column -->
			<div class="footer-brand">
				<a href="/" class="brand-name">
					<span class="brand-icon">⚡</span>
					{SITE.title}
				</a>
				<p class="tagline">{FOOTER.tagline}</p>
				<div class="social-links">
					{
						SOCIAL_LINKS.map((social) => (
							<a
								href={social.url}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={social.label}
							>
								<svg
									viewBox="0 0 16 16"
									aria-hidden="true"
									width="20"
									height="20"
								>
									<path fill="currentColor" d={social.icon} />
								</svg>
							</a>
						))
					}
				</div>
			</div>

			<!-- Navigation column -->
			<div class="footer-col">
				<h4>Navigation</h4>
				{NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
				{
					FOOTER.links.map((link) => (
						<a href={link.href}>{link.label}</a>
					))
				}
			</div>

			<!-- Topics column -->
			<div class="footer-col">
				<h4>Topics</h4>
				{
					TOPICS.map((topic) => (
						<span class="topic-item">
							{topic.icon} {topic.title}
						</span>
					))
				}
			</div>
		</div>

		<div class="footer-bottom">
			<p>{FOOTER.copyright}</p>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--glass-border);
		background: var(--bg-secondary);
		padding: var(--space-3xl) 0 var(--space-xl);
		margin-top: var(--space-4xl);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: var(--space-3xl);
	}

	.footer-brand {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	.brand-name {
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--text-primary);
		text-decoration: none;
		display: flex;
		align-items: center;
		gap: var(--space-sm);
	}

	.brand-name:hover {
		color: var(--text-primary);
	}

	.tagline {
		color: var(--text-tertiary);
		font-size: 0.9rem;
		max-width: 300px;
	}

	.social-links {
		display: flex;
		gap: var(--space-md);
		margin-top: var(--space-sm);
	}

	.social-links a {
		color: var(--text-tertiary);
		transition: color var(--transition-fast);
		display: flex;
	}

	.social-links a:hover {
		color: var(--accent-cyan);
	}

	.footer-col {
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	.footer-col h4 {
		color: var(--text-primary);
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		margin-bottom: var(--space-sm);
	}

	.footer-col a {
		color: var(--text-tertiary);
		text-decoration: none;
		font-size: 0.9rem;
		transition: color var(--transition-fast);
	}

	.footer-col a:hover {
		color: var(--text-primary);
	}

	.topic-item {
		color: var(--text-tertiary);
		font-size: 0.9rem;
	}

	.footer-bottom {
		margin-top: var(--space-2xl);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--glass-border);
		text-align: center;
	}

	.footer-bottom p {
		color: var(--text-tertiary);
		font-size: 0.8rem;
	}

	@media (max-width: 768px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}
	}
</style>
