---
// PostCard.astro — Glassmorphism blog post card
import FormattedDate from "./FormattedDate.astro";
import TagBadge from "./TagBadge.astro";

interface Props {
    title: string;
    description?: string;
    date: string | Date;
    slug: string;
    heroImage?: string;
    tags?: string[];
    featured?: boolean;
}

const {
    title,
    description,
    date,
    slug,
    heroImage,
    tags = [],
    featured = false,
} = Astro.props;

const parsedDate = typeof date === "string" ? new Date(date) : date;
---

<article class:list={["post-card", "glass-card", { featured }]}>
    <a href={`/blog/${slug}/`} class="card-link">
        {
            heroImage && (
                <div class="card-image">
                    <img
                        src={heroImage}
                        alt={title}
                        loading="lazy"
                        width="720"
                        height="360"
                    />
                    <div class="image-overlay" />
                </div>
            )
        }
        <div class="card-body">
            {
                tags.length > 0 && (
                    <div class="card-tags">
                        {tags.slice(0, 3).map((tag) => (
                            <TagBadge tag={tag} />
                        ))}
                    </div>
                )
            }
            <h3 class="card-title">{title}</h3>
            {description && <p class="card-description">{description}</p>}
            <div class="card-meta">
                <FormattedDate date={parsedDate} />
            </div>
        </div>
    </a>
</article>

<style>
    .post-card {
        overflow: hidden;
        height: 100%;
    }

    .card-link {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        height: 100%;
    }

    .card-image {
        position: relative;
        overflow: hidden;
        aspect-ratio: 16 / 9;
    }

    .card-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform var(--transition-slow);
        border-radius: 0;
    }

    .post-card:hover .card-image img {
        transform: scale(1.05);
    }

    .image-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            to top,
            rgba(10, 10, 15, 0.6) 0%,
            transparent 50%
        );
        pointer-events: none;
    }

    .card-body {
        padding: var(--space-lg);
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-xs);
        margin-bottom: var(--space-sm);
    }

    .card-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: var(--space-sm);
        line-height: 1.3;
        transition: color var(--transition-fast);
    }

    .post-card:hover .card-title {
        color: var(--accent-cyan);
    }

    .card-description {
        color: var(--text-tertiary);
        font-size: 0.9rem;
        line-height: 1.5;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-meta {
        margin-top: var(--space-md);
        color: var(--text-tertiary);
        font-size: 0.8rem;
    }

    /* Featured card (larger) */
    .featured {
        grid-column: 1 / -1;
    }

    .featured .card-link {
        flex-direction: row;
    }

    .featured .card-image {
        flex: 1;
        aspect-ratio: auto;
        min-height: 300px;
    }

    .featured .card-body {
        flex: 1;
        padding: var(--space-xl);
        justify-content: center;
    }

    .featured .card-title {
        font-size: 1.5rem;
    }

    @media (max-width: 768px) {
        .featured .card-link {
            flex-direction: column;
        }

        .featured .card-image {
            aspect-ratio: 16 / 9;
            min-height: auto;
        }

        .featured .card-title {
            font-size: 1.25rem;
        }
    }
</style>
